# ==============================================================================
# ROUGHCLICK DIGITAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Operational variables inventory for production & local development (RC-24)
# ==============================================================================

# Public Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://roughclick.com

# Admin Authentication (Mandatory in production; fail-closed if unconfigured)
ADMIN_EMAIL=admin@roughclick.com
ADMIN_PASSWORD=change-me-to-a-strong-secret-in-production
ADMIN_SESSION_SECRET=min-32-char-cryptographically-random-secret-for-hmac-sha256

# Transactional Email Dispatch (Resend API)
# Required for sending inquiry notifications to engineering team
RESEND_API_KEY=re_example_test_api_key_123456789
NOTIFICATION_EMAIL=leads@roughclick.com

# Cloud Key-Value Persistence (Vercel KV / Upstash Redis REST)
# When configured, inquiries and blog posts are saved with atomic durability
KV_REST_API_URL=https://example-kv.upstash.io
KV_REST_API_TOKEN=example_kv_rest_api_bearer_token

# Optional: Google Gemini AI API Key (for Co-Pilot article drafting)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: External Database Migration
# DATABASE_URL=postgresql://postgres:password@localhost:5432/roughclick
